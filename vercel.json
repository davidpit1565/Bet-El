{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "dependabot/*": false,
      "codex/*": false
    }
  },
  "rewrites": [
    {
      "source": "/shas-daf/:masechta/:daf/:amud",
      "destination": "https://www.shas.org/daf-pdf/api/?masechta=:masechta&daf=:daf&amud=:amud"
    }
  ],
  "headers": [
    {
      "source": "/shas-daf/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    }
  ]
}
