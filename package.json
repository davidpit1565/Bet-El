{
  "name": "tehilim",
  "version": "1.0.0",
  "description": "Bet-El - daily study app: Chok LeYisrael, daily Tehillim, daily Zohar, Hebrew calendar and zmanim",
  "private": true,
  "scripts": {
    "test": "npm run check:blocking",
    "check:blocking": "node scripts/check-blocking-resources.mjs",
    "cap:sync": "rm -rf www && mkdir -p www && cp index.html sw.js manifest.json icon-192.png icon-512.png www/ && cp -r data www/data && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0"
  },
  "keywords": [
    "tehilim",
    "psalms",
    "hebrew",
    "chok-leyisrael",
    "zohar",
    "daily-study",
    "beit-el"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
