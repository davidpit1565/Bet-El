{
  "appId": "com.beitel.tehilim",
  "appName": "תמיד",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#080d19"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "backgroundColor": "#080d19",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080d19"
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  },
  "android": {
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/local-notifications",
      "@capacitor/splash-screen",
      "@capacitor/status-bar"
    ]
  }
}
