rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* "Users today": one document per Israel calendar day (daily/2026-10-27), counted once per device per day by the client.
       Public get; clients may only create it with count 1 or add exactly 1 - the number resets daily so abuse never accumulates. */
    match /daily/{day} {
      allow get: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
    }

    /* Visit statistics (index.html logVisitStats): one document per Israel calendar day (visitLog/2026-11-12) holding ONLY
       aggregate counters - total sessions, per-hour (h00..h23), platform, new/returning, sessions and seconds in the app.
       Read ONLY by the owner's Google account (set the uid below, shown on visit-stats.html after signing in); clients may create it with 1s and add to it. */
    match /visitLog/{day} {
      allow get, list: if request.auth != null && request.auth.uid == 'IwBizvkBEoYlOSGUOzJsVvI3sVY2';
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['total','ses','secs','new','ret','ios','android','web','tz','h00','h01','h02','h03','h04','h05','h06','h07','h08','h09','h10','h11','h12','h13','h14','h15','h16','h17','h18','h19','h20','h21','h22','h23'])
        && (!('tz' in request.resource.data) || request.resource.data.tz.keys().size() <= 3)
        && request.resource.data.total == 1;
      allow update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['total','ses','secs','new','ret','ios','android','web','tz','h00','h01','h02','h03','h04','h05','h06','h07','h08','h09','h10','h11','h12','h13','h14','h15','h16','h17','h18','h19','h20','h21','h22','h23'])
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 6
        && (!('tz' in request.resource.data) || request.resource.data.tz.keys().size() <= 150)
        && request.resource.data.get('total', 0) - resource.data.get('total', 0) <= 1
        && request.resource.data.get('secs', 0) - resource.data.get('secs', 0) <= 7200
        && request.resource.data.get('secs', 0) >= resource.data.get('secs', 0)
        && request.resource.data.get('total', 0) >= resource.data.get('total', 0);
    }

    match /stats/visits {
      allow get: if true;
      allow update: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
    }

    /* App "Rate us / feedback" form (index.html __betelSaveFeedback).
       Public, unauthenticated clients write-only: anyone can create a
       feedback doc, nobody can read, update or delete it back (so a
       stranger can't browse other users' messages or tamper with one
       already sent). Field set is locked to exactly what the client
       writes, each with its real type and a sane max length, to stop
       spammy/huge payloads. */
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','ua','lang','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.subject is string && request.resource.data.subject.size() < 200
        && request.resource.data.message is string && request.resource.data.message.size() < 5000
        && request.resource.data.ua is string && request.resource.data.ua.size() < 500
        && request.resource.data.lang is string && request.resource.data.lang.size() < 20
        && request.resource.data.createdAt is number;
    }

    /* Push tokens (index.html: web window.enablePush and native
       window.__savePushToken). Doc id = the FCM token itself. Clients may
       only create or overwrite their own token doc - never read, list or
       delete (nobody can harvest the token list); campaigns are sent from the
       Firebase Console / Admin SDK, which bypass these rules. Field set and
       types are locked to exactly what the clients write. */
    match /pushTokens/{tokenId} {
      allow read, delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['token','platform','ua','lang','updatedAt'])
        && request.resource.data.keys().hasAll(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20 && request.resource.data.token.size() < 4096
        && request.resource.data.token == tokenId
        && request.resource.data.platform in ['ios', 'web']
        && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 500))
        && (!('lang' in request.resource.data) || (request.resource.data.lang is string && request.resource.data.lang.size() <= 40))
        && request.resource.data.updatedAt is number && request.resource.data.updatedAt > 0;
    }
  }
}
