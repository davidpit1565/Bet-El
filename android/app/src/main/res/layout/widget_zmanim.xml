<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="ltr" android:background="@drawable/widget_bg"
    android:padding="14dp">
    <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:paddingBottom="6dp" />
    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layoutDirection="ltr" />
    <TextView android:id="@+id/tv_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
