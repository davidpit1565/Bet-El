<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layoutDirection="ltr" android:paddingTop="3dp" android:paddingBottom="3dp">
    <TextView android:id="@+id/row_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="left" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/row_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:layout_marginLeft="8dp" />
</LinearLayout>
