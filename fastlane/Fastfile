# App Store Connect upload for Tamid (com.beitel.tehilim).
# Auth: App Store Connect API key from the environment - ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (.p8).
# Nothing here ever submits for review; press "Submit for Review" by hand in App Store Connect.
#   node scripts/fastlane-metadata.mjs              # refresh fastlane/metadata + fastlane/screenshots
#   fastlane ios upload_build ipa:build/export/App.ipa  # binary only
#   fastlane ios upload_listing                     # texts + screenshots (he, en-US)
#   fastlane ios upload_texts                       # texts + App Review notes only (he, en-US)
#   fastlane ios upload_listing version:2.0.1 build:7 locales:he,en-US,fr-FR   # 2.0.1 with the French page
#   Allowed locales: he, en-US, fr-FR (never ru). Default: he,en-US.
#   fastlane ios asc_status                         # read-only: localizations, review notes
#   fastlane ios select_build                       # attach build 6 to version 2.0
default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  # Version 2.0 is he + en-US only (fr-FR / ru were removed so Apple doesn't ask for their screenshots);
  # from 2.0.1 fr-FR can be added with locales:he,en-US,fr-FR. ru is never sent. deliver gets a staged copy
  # of fastlane/metadata and fastlane/screenshots with only the chosen locales.
  ALLOWED_LOCALES = %w[he en-US fr-FR].freeze

  def chosen_locales(options)
    locales = (options[:locales] || "he,en-US").split(",").map(&:strip)
    bad = locales - ALLOWED_LOCALES
    UI.user_error!("Locales not allowed: #{bad.join(', ')} (only #{ALLOWED_LOCALES.join(', ')})") unless bad.empty?
    locales
  end

  def staged_metadata(locales)
    staged = File.expand_path("../build/metadata-#{locales.join('-')}", __dir__)
    FileUtils.rm_rf(staged)
    FileUtils.mkdir_p(staged)
    (locales + ["review_information"]).each { |d| FileUtils.cp_r(File.expand_path("metadata/#{d}", __dir__), staged) }
    FileUtils.cp(File.expand_path("metadata/copyright.txt", __dir__), staged)
    staged
  end

  def staged_screenshots(locales)
    staged = File.expand_path("../build/screenshots-#{locales.join('-')}", __dir__)
    FileUtils.rm_rf(staged)
    FileUtils.mkdir_p(staged)
    locales.each do |l|
      src = File.expand_path("screenshots/#{l}", __dir__)
      UI.user_error!("No screenshots for #{l} - run node scripts/fastlane-metadata.mjs") unless Dir.exist?(src)
      FileUtils.cp_r(src, staged)
    end
    staged
  end

  # TestFlight ONLY, internal testing: uploads the binary and never touches an App Store version or submits for review.
  # The "Internal" beta group (isInternalGroup, hasAccessToAllBuilds = automatic distribution) receives every processed build.
  lane :upload_testflight do |options|
    upload_to_testflight(
      api_key: asc_key,
      ipa: options[:ipa] || "build/export/App.ipa",
      groups: ["Internal"],
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  lane :upload_build do |options|
    upload_to_app_store(
      api_key: asc_key,
      ipa: options[:ipa] || "build/export/App.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  lane :upload_listing do |options|
    locales = chosen_locales(options)
    deliver(
      api_key: asc_key,
      metadata_path: staged_metadata(locales),
      screenshots_path: staged_screenshots(locales),
      app_version: options[:version] || "2.0",
      build_number: options[:build] || "6",
      skip_binary_upload: true,
      skip_app_version_update: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  # Texts only (no screenshots) for the chosen locales (default he + en-US), plus the App Review notes; ru is never sent.
  # Sign-in stays "not required" (deliver sets demo_account_required=false without demo credentials).
  lane :upload_texts do |options|
    locales = chosen_locales(options)
    deliver(
      api_key: asc_key,
      app_version: options[:version] || "2.0",
      metadata_path: staged_metadata(locales),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  # Remove version localizations that the live version does not have (never one the live version has).
  lane :remove_locales do |options|
    asc_key
    app = Spaceship::ConnectAPI::App.find("com.beitel.tehilim")
    platform = Spaceship::ConnectAPI::Platform::IOS
    edit = app.get_edit_app_store_version(platform: platform)
    live_locales = app.get_live_app_store_version(platform: platform).get_app_store_version_localizations.map(&:locale)
    (options[:locales] || "").split(",").each do |locale|
      UI.user_error!("#{locale} exists on the live version - not removing") if live_locales.include?(locale)
      loc = edit.get_app_store_version_localizations.find { |l| l.locale == locale }
      next UI.message("#{locale}: not on #{edit.version_string}") unless loc
      loc.delete!
      UI.success("Removed #{locale} from #{edit.version_string}")
    end
  end

  # Read-only: localizations of the editable and the live version, plus the App Review details.
  lane :asc_status do
    asc_key
    app = Spaceship::ConnectAPI::App.find("com.beitel.tehilim")
    platform = Spaceship::ConnectAPI::Platform::IOS
    { "edit" => app.get_edit_app_store_version(platform: platform),
      "live" => app.get_live_app_store_version(platform: platform) }.each do |label, v|
      next UI.message("#{label}: none") unless v
      UI.message("#{label} #{v.version_string} (#{v.app_store_state}): " + v.get_app_store_version_localizations.map(&:locale).sort.join(", "))
    end
    detail = app.get_edit_app_store_version(platform: platform).fetch_app_store_review_detail(includes: "appStoreReviewAttachments")
    UI.message("demo_account_required: #{detail.demo_account_required.inspect}")
    UI.message("attachments: #{(detail.app_store_review_attachments || []).map(&:file_name).inspect}")
    puts "----- review notes -----\n#{detail.notes}\n------------------------"
  end

  # deliver only attaches a build when it submits, so attach it here (still no submission).
  lane :select_build do |options|
    asc_key
    version_string = options[:version] || "2.0"
    build_number = options[:build] || "6"
    app = Spaceship::ConnectAPI::App.find("com.beitel.tehilim")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable #{version_string} version") unless version && version.version_string == version_string
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version_string, build_number: build_number).first
    UI.user_error!("Build #{build_number} not found yet") unless build
    UI.user_error!("Build #{build_number} is still #{build.processing_state}") unless build.processed?
    version.select_build(build_id: build.id)
    UI.success("Selected build #{build_number} for #{version_string}")
  end
end
